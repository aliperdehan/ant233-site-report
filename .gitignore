# OS junk
.DS_Store

# Rendered pandoc output (regenerate with the command in README.md)
bib/*.pdf
bib/*.html
/AI-USE.pdf
/annotated-bibliography-with-ai-use.pdf

# Scratch/comparison copies, not source content
bib/*-pre-grammarly.md

# Office lock files
~$*.docx
~$*.doc
.~lock.*

# Reference material (course handouts, source PDFs) — not authored content,
# kept locally for reference but not tracked to keep the repo focused on
# your own writing. Remove these lines if you'd rather have them versioned too.
/info/
/sources/
*.pdf

# Python bytecode
__pycache__/

# Map project: regenerate with `python fetch_data.py` then `python make_map.py` (in map/)
map/output/*.svg
map/data/raw/
